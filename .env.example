# Copy to .env and set a unique local Django secret before starting services.

# Postgres
POSTGRES_DB=bloom
POSTGRES_USER=bloom
POSTGRES_PASSWORD=bloom
DATABASE_URL=postgres://bloom:bloom@db:5432/bloom

# Django
# Generate a unique local value; this setting has no fallback.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# School-project payment simulation (no payment is collected or verified)
PAYMENT_PROVIDER=apps.payments.providers.fake.FakeProvider

# Seed demo users/catalog/orders on boot (idempotent)
SEED_DEMO_DATA=1

# Optional: supply unique local administrator credentials only when intentionally
# creating an account on first boot. Do not commit or document their values.
